DATABASE_URL=postgresql://user:password@localhost:5432/family_budget

# 明細のルール外分類（任意）。未設定のときはルールのみで取り込み、AI はスキップ。
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# AI_CLASSIFICATION_CONFIDENCE_THRESHOLD=0.7
# AI_CONFIDENCE_REVIEW_THRESHOLD=0.8

# Supabase Auth 連携。dev / prod ともに別々の Supabase プロジェクトを使い、
# /health 以外のエンドポイントは Authorization: Bearer <JWT> を必須にする。
# Project Settings -> API の Project URL（https://xxxx.supabase.co）
SUPABASE_URL=
# Legacy HS256 トークンのみ使う場合に設定。JWT Signing Keys（ES256 等）なら不要。
# Project Settings -> API -> JWT Settings -> Legacy JWT Secret
# SUPABASE_JWT_SECRET=
# SUPABASE_JWT_AUDIENCE=authenticated
# SUPABASE_JWT_ALGORITHMS_ASYMMETRIC=ES256,RS256

# ログ設定。API アクセスログは body を出さず、メタ情報のみ stdout とログファイルに JSON 形式で出力。
# LOG_LEVEL=INFO
# LOG_API_ACCESS=true
# LOG_FILE_ENABLED=true
# LOG_FILE_PATH=logs/app.log
# LOG_FILE_MAX_BYTES=10485760
# LOG_FILE_BACKUP_COUNT=5
# AI 詳細ログは店名・分類結果を含むため、必要なときだけ有効化。
# LOG_AI_CLASSIFICATION_DETAIL=false

# 明細メール着信の LINE。未設定なら送らず、明細の取込自体は成功させる。
# 値は Git に入れない。Apps Script 側の秘密鍵はスクリプトプロパティに置く。
LINE_CHANNEL_ACCESS_TOKEN=
LINE_GROUP_ID=
# クエリ無しの https:// 基点。手順2は API が ?year=&month= を付ける。例: https://example.com/upload
APP_UPLOAD_URL=
# POST /notify/statement-mail の秘密鍵。ユーザー JWT とは別。
REMIND_CRON_SECRET=

# Alembic（backend をカレントにして実行）
# python -m alembic upgrade head
# python -m alembic revision --autogenerate -m "変更の説明"
